# ============================
# EcoMinds / SRCD — Backend
# Variables de entorno requeridas
# ============================

# Entorno: development | production
NODE_ENV=development

# Puerto del servidor Express
PORT=3000

# URL pública del backend (usada en logs y emails)
PUBLIC_URL=http://localhost:3000

# URL del frontend para CORS. En producción es obligatoria.
# Puedes incluir múltiples orígenes separados por coma.
FRONTEND_URL=http://localhost:5173

# ==========================================
# Base de datos PostgreSQL
# ==========================================
DATABASE_URL=******localhost:5432/ecominds

# (Opcional en prod) Ruta al certificado CA de PostgreSQL.
# Si se define, se valida el certificado del servidor.
# PG_CA_CERT=/ruta/a/ca-certificate.crt

# ==========================================
# Seguridad — JWT y CSRF
# ==========================================
# Mínimo 32 caracteres en producción
JWT_SECRET=cambiar_por_un_secreto_largo_de_al_menos_32_chars
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_largo_de_al_menos_32_chars
CSRF_SECRET=cambiar_por_secreto_csrf_largo_de_al_menos_32_chars

# ==========================================
# Email (SMTP)
# ==========================================
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=usuario@ejemplo.com
SMTP_PASS=password_o_app_key
SMTP_FROM="EcoMinds <no-reply@ejemplo.com>"

# URL base para enlaces de verificación y recuperación
EMAIL_FRONTEND_URL=http://localhost:5173

# Email del administrador para notificaciones
ADMIN_EMAIL=admin@ejemplo.com
