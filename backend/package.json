{
  "name": "srcd-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SRCD - Auditoria de Cumplimiento (backend)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "sequelize-cli db:migrate --config src/config/sequelize-cli.js --migrations-path src/migrations --seeders-path src/seeders",
    "migrate:undo": "sequelize-cli db:migrate:undo --config src/config/sequelize-cli.js --migrations-path src/migrations",
    "seed": "sequelize-cli db:seed:all --config src/config/sequelize-cli.js --migrations-path src/migrations --seeders-path src/seeders",
    "test:email": "node test/email.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "resend": "^6.21.0",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2"
  },
  "type": "module"
}
